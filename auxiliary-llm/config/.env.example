# auxiliary-llm — configuration template
# Copy to the project root as .env, then adjust. `install.sh` does this for you.

# ===== image =====
# config/buildCMD/build.sh tags the image with this value.
AUX_IMAGE=auxiliary-llm:latest

# ===== target GPU compute capability =====
# Empty = auto-detect the local GPU (recommended). Falls back to 75;80;86;89.
# Wrong value symptom: the image builds and starts, then inference fails with
#   CUDA error: no kernel image is available for execution on the device
#
#   Common values: Pascal P100=60  Pascal P40=61  Volta V100=70  Turing RTX20xx/T4=75
#                  Ampere A100=80  Ampere RTX30xx/A3000=86  Ada RTX40xx/L40=89
#                  Hopper H100=90  Blackwell RTX50xx/B200=120
#   Multiple values use semicolons; build time grows with the number of archs:
#   CUDA_ARCH=75;80;86;89
#   Everything the toolchain supports (slowest, largest image): CUDA_ARCH=all
CUDA_ARCH=

# ===== host ports =====
LLM_PORT=8888
EMBED_PORT=1888
RERANK_PORT=1999

# ===== models (mounted read-only at /models) =====
# Default ./models. Point this elsewhere to reuse an existing model directory.
MODELS_DIR=./models

LLM_MODEL=qwen3.5-4b-q8_0.gguf
LLM_ALIAS=aux-llm

EMBED_MODEL=bge-m3-q8_0.gguf
EMBED_ALIAS=aux-embedding

RERANK_MODEL=bge-reranker-v2-m3-q8_0.gguf
RERANK_ALIAS=aux-reranker

# ===== LLM parameters =====
# Context window. Larger = more VRAM; 65536 is a good default for agent workloads.
LLM_CTX=65536
# Speculative decoding. v0.4.0+ calls it draft-mtp (older forks used "mtp").
LLM_SPEC_TYPE=draft-mtp
LLM_SPEC_N_MAX=2
# Only used by draft-mtp-adaptive: floor of the adaptive depth, must be in [1, N_MAX].
LLM_SPEC_N_MIN_ADAPTIVE=2
# KV quantisation: V side 4-bit TurboQuant, K side q8_0 (K is more sensitive).
LLM_KV_K=q8_0
LLM_KV_V=turbo4
# Batching: the main lever for prefill throughput and VRAM.
LLM_BATCH=1024
LLM_UBATCH=512
LLM_THREADS=8
# KV state snapshot cache (MiB): avoids recomputing a repeated prefix.
LLM_CACHE_RAM=4096
LLM_N_PREDICT=8192
# GPU layers: 99 = all. Lower it for CPU inference or when VRAM is tight.
LLM_NGL=99

# ===== sampling defaults =====
LLM_TEMP=0.5
LLM_TOP_P=0.7
LLM_TOP_K=20
LLM_REPEAT_PENALTY=1.1
