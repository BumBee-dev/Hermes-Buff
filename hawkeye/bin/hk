#!/usr/bin/env python3
"""hk entry point — keeps ``lib/`` importable without installing anything.

Three guards before the real code runs, in this order:

* **Interpreter override.** ``HAWKEYE_PYTHON`` names the interpreter hk should run under. An explicit
  answer always wins; the re-exec happens once and is guarded, so a bad value cannot loop.
* **Interpreter discovery.** hk needs Python >= 3.11 (``tomllib``). Hosts whose system python is
  older — Ubuntu 18.04 and Debian 10 ship 3.6/3.7 — still have a usable interpreter inside Hermes
  itself, so instead of failing we look for one (``bin/_hk_interp.py``) and re-exec into it. The
  search is by capability, never by a hardcoded path: ``HERMES_HOME/tools/python-*`` first, then the
  per-install environments, and each candidate is actually launched to prove it imports ``tomllib``
  and ``sqlite3``.
* **Version check.** If nothing was found, say so once, name what was searched, and stop — that beats
  a traceback about a missing module three layers deep.

Kept to old syntax on purpose: on a 3.6 host this file has to *run* in order to explain the problem.
"""

import os
import sys

_REEXEC_FLAG = "HAWKEYE_PY_REEXEC"


try:
    import _hk_interp                            # lives next to this file
except ImportError:
    _hk_interp = None


def _clean_env():
    """The environment to hand a new interpreter: ours, minus what changes who it claims to be.

    ``os.execv`` passes the caller's environment through untouched, so a stray PYTHONPATH -- the
    normal state inside a cron wrapper or a CI step -- was inherited by the re-executed hk, which
    then rejected *itself*: the discovery step found a good interpreter, exec'd into it, and the new
    process reported 3.7 because the caller's sitecustomize said so. Measured before this change:
    ``PYTHONPATH=<liar> /usr/bin/python3 ./bin/hk gate-check`` -> "needs Python >= 3.11 (found 3.7)".
    """
    if _hk_interp is not None:
        return _hk_interp._probe_env()
    env = dict(os.environ)
    for key in ("PYTHONPATH", "PYTHONHOME", "PYTHONSTARTUP"):
        env.pop(key, None)
    return env


def _re_exec(interpreter):
    """Replace this process, once. Falls back to running here if the exec fails."""
    env = _clean_env()
    # The guard goes into the *new* environment only: putting it in os.environ as well would be a
    # second source of truth for "did the re-exec happen", and the child is the one that needs it.
    env[_REEXEC_FLAG] = "1"
    try:
        os.execve(interpreter, [interpreter] + sys.argv, env)
    except OSError as exc:                       # fall through and run here instead
        sys.stderr.write("hk: could not re-exec into %s (%s); continuing with %s\n"
                         % (interpreter, exc, sys.executable))


_wanted = (os.environ.get("HAWKEYE_PYTHON") or "").strip()
if (
    _wanted
    and os.environ.get(_REEXEC_FLAG) != "1"
    and os.path.isfile(_wanted)
    and os.access(_wanted, os.X_OK)
    and os.path.realpath(_wanted) != os.path.realpath(sys.executable)
):
    _re_exec(_wanted)

if sys.version_info < (3, 11) and os.environ.get(_REEXEC_FLAG) != "1":
    found = _hk_interp.find(exclude=sys.executable) if _hk_interp else None
    if found:
        sys.stderr.write("hk: %s is python %d.%d, which is too old; using %s instead\n"
                         % (sys.executable, sys.version_info[0], sys.version_info[1], found))
        _re_exec(found)
    elif _hk_interp is not None and _hk_interp.usable(sys.executable):
        # Excluding the running interpreter is right in the normal case, but when it *lies* about
        # its version the only usable candidate is the binary we are already in. Re-exec into it
        # with a clean environment: the version we reported was the environment's, not its own.
        sys.stderr.write("hk: %s reports python %d.%d, but the interpreter itself is usable;"
                         " re-running under a clean environment\n"
                         % (sys.executable, sys.version_info[0], sys.version_info[1]))
        _re_exec(sys.executable)

if sys.version_info < (3, 11):
    searched = _hk_interp.describe_searched() if _hk_interp else []
    sys.stderr.write("hk: needs Python >= 3.11 (found %d.%d at %s)\n"
                     % (sys.version_info[0], sys.version_info[1], sys.executable))
    if searched:
        sys.stderr.write("hk: searched for one inside Hermes and found nothing usable:\n")
        for line in searched:
            sys.stderr.write("      %s\n" % line)
    sys.stderr.write("hk: install python3.11+, or set HAWKEYE_PYTHON to any Python >= 3.11\n")
    sys.exit(1)

try:
    import sqlite3  # noqa: F401
    import tomllib   # noqa: F401
except ImportError as exc:
    sys.exit("hk: %s is missing from %s; set HAWKEYE_PYTHON to a complete Python >= 3.11"
             % (exc.name, sys.executable))

from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from hawkeye.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
